# Regenerated by Next on every run, and `distDir` differs between dev and build (see
# apps/web/next.config.ts), so the committed copy flips between `.next` and `.next-dev` and
# dirties the tree every time you switch. It is a generated file with nothing to review.
apps/web/next-env.d.ts
