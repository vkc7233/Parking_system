# ---------------------------------------------------------------------------
# Parking Marketplace - environment
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every vendor below has a working fake, so the app runs
# end to end with this file exactly as it ships (spec section 13 lead times, section 16 risks).

# --- Supabase -------------------------------------------------------------
# The two keys below are Supabase's standard LOCAL demo keys. They are safe to commit: they are
# signed with the default local JWT secret and are worthless against any hosted project. They
# are the same on every machine, which is what makes `pnpm setup` a single command.
#
# Replace all three with the hosted project's values when deploying. `pnpm db:start` prints the
# local ones again if you ever need them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-side only. Bypasses RLS - never expose it to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Access pass ----------------------------------------------------------
# HMAC secret for the QR access pass (assumption A5). `pnpm setup` generates a fresh one; this
# placeholder exists only so the file is valid if copied by hand. Generate another with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_PASS_SECRET=replace-me-local-development-only-at-least-32-chars

# --- Payments (Razorpay, spec 9.7) ---------------------------------------
# 'fake' until the merchant account and Payouts activation clear (1-2 weeks, spec 13).
PAYMENTS_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYOUT_ACCOUNT_NUMBER=

# --- Notifications (MSG91, spec 9.9) -------------------------------------
# 'fake' prints OTPs and messages to the dev server console.
NOTIFICATIONS_PROVIDER=fake
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PARKNG
MSG91_OTP_TEMPLATE_ID=
MSG91_WHATSAPP_NUMBER=

# --- Maps (Google Maps Platform, spec 9.6) -------------------------------
# 'fake' uses offline Ahmedabad fixtures and makes no billed calls.
# Where this deployment is reachable. Used for sitemap and social-card URLs, which must be
# absolute - a relative URL in a sitemap is ignored by crawlers without any error.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_MAPS_PROVIDER=fake
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Observability (spec 9.10) -------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
